{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Quant Studio: Deploy to Antigravity (One-Touch Fast Sync)",
      "type": "shell",
      "command": "${workspaceFolder}/deploy_to_antigravity.sh",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Quant Studio: Full VSIX Build & Install",
      "type": "shell",
      "command": "${workspaceFolder}/deploy_to_antigravity.sh --full",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Quant Studio: Watch & Auto-Deploy on Save",
      "type": "shell",
      "command": "${workspaceFolder}/deploy_to_antigravity.sh --watch",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Quant Studio: Open Chart Webview",
      "type": "shell",
      "command": "echo 'Opening Quant Studio Chart Webview...'",
      "problemMatcher": []
    },
    {
      "label": "Quant Studio: Run Unit Tests",
      "type": "shell",
      "command": "${workspaceFolder}/venv/bin/pytest tests/test_debug_runner.py tests/test_extension_manifest.py tests/test_extension_webview.py -v",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
